{
  "Component: Spectral Motor": {
    "index": "2",
    "category": "sorcery",
    "sections": [
      {
        "type": "title",
        "value": "Spectral Motor"
      },
      {
        "type": "text",
        "json": [
          {
            "text": "The contraptions of "
          },
          {
            "text": "Create",
            "color": "blue"
          },
          {
            "text": " hunger for rotational force. With this spell I conjure a temporary "
          },
          {
            "text": "spectral motor",
            "color": "blue"
          },
          {
            "text": " at the block I aim at: a spinning shaft whose sides grip like a small cogwheel.\n\nIts shaft points into the targeted block, unless a cogwheel or shaft next to it suggests another direction. Once its time has run out, the motor vanishes."
          }
        ]
      },
      {
        "type": "text",
        "json": [
          {
            "text": "Speed",
            "color": "dark_purple"
          },
          {
            "text": " raises the rotation from 16 to 256 RPM.\n"
          },
          {
            "text": "Magnitude",
            "color": "dark_purple"
          },
          {
            "text": " doubles the stress capacity with every point, from 256 to 16,384 SU.\n"
          },
          {
            "text": "Duration",
            "color": "dark_purple"
          },
          {
            "text": " lets the motor remain longer.\n"
          },
          {
            "text": "Precision",
            "color": "dark_purple"
          },
          {
            "text": " reverses the direction of rotation.\n\nIf I cast the spell on a motor I conjured before, it takes on the new values and its time starts anew."
          }
        ]
      }
    ],
    "related_recipes": [
      {
        "type": "spell_part",
        "location": "dmnr:components/spectral_motor"
      }
    ]
  },
  "Arcane Engine": {
    "index": "1",
    "category": "artifice",
    "sections": [
      {
        "type": "title",
        "value": "Arcane Engine"
      },
      {
        "type": "text",
        "json": [
          {
            "text": "The "
          },
          {
            "text": "Arcane Engine",
            "color": "blue"
          },
          {
            "text": " is a shaft that never stops turning, whose sides grip like a small cogwheel. It drives the machines of "
          },
          {
            "text": "Create",
            "color": "blue"
          },
          {
            "text": " with "
          },
          {
            "text": "16 RPM",
            "color": "gold"
          },
          {
            "text": " and "
          },
          {
            "text": "512 SU",
            "color": "gold"
          },
          {
            "text": ", as much stress as a Large Water Wheel.\n\nWith brimstone it can be upgraded to the "
          },
          {
            "text": "Brimstone Engine",
            "color": "blue"
          },
          {
            "text": ": "
          },
          {
            "text": "128 RPM",
            "color": "gold"
          },
          {
            "text": " and "
          },
          {
            "text": "8192 SU",
            "color": "gold"
          },
          {
            "text": "."
          }
        ]
      }
    ],
    "related_recipes": [
      {
        "type": "manaweaving_altar",
        "location": "dmnr:create/arcane_engine"
      },
      {
        "type": "manaweaving_altar",
        "location": "dmnr:create/brimstone_engine"
      }
    ]
  }
}
